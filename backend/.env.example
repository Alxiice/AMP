# AMP Backend Configuration
# ===========================
# Copy this file to .env and customize as needed.
# All settings are optional (defaults are defined in config.py).

# App
APP_NAME=AMP Backend
APP_VERSION=0.1.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Directories (relative to backend/ or absolute paths)
# BASE_DIR=.
# CACHE_DIR=.amp/cache
# CHUNKS_DIR=.amp/cache/chunks
# LOGS_DIR=.amp/logs

# Database
# USERDB_PATH=userdb.sqlite
# PLAYDB_PATH=playdb.sqlite

# Cache settings
CACHE_MAX_SIZE_MB=500
CHUNK_SIZE_SEC=10
BUFFER_AHEAD_SEC=15

# Audio
AUDIO_QUALITY=high
AUDIO_FORMAT=mp3
AUDIO_BITRATE=192

# YouTube
# YOUTUBE_API_KEY=
# YTMUSICAPI_COOKIES=cookies.json  # Path to ytmusicapi cookies file

# Logging
LOG_LEVEL=INFO
# LOG_FILE=.amp/logs/app.log
