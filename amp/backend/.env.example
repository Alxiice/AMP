# AMP Backend Environment Configuration
# ========================================
# Copy this file to .env and modify the values for your environment.

# App Settings
APP_NAME="AMP Backend"
APP_VERSION="0.1.0"
DEBUG=true

# Server Settings
HOST=0.0.0.0
PORT=8000

# Audio Settings
AUDIO_QUALITY=high        # low, medium, high, best
AUDIO_FORMAT=mp3          # mp3, opus, etc.
AUDIO_BITRATE=192        # Bitrate in kbps

# Cache Settings
CACHE_MAX_SIZE_MB=500    # Maximum cache size in MB
CHUNK_SIZE_SEC=10        # Chunk duration in seconds
BUFFER_AHEAD_SEC=15      # Buffer ahead in seconds

# YouTube API Settings
# Optional: YouTube Data API v3 key (for additional features)
YOUTUBE_API_KEY=

# ytmusicapi Settings
# Path to cookies.json file for ytmusicapi (authenticated mode)
# You can generate this by running: ytmusicapi oauth
YTMUSICAPI_COOKIES=

# OAuth Settings (for YouTube OAuth flow)
# Get these from: https://console.cloud.google.com/apis/credentials
# Create a new OAuth 2.0 Client ID for "Web application"
# Authorized JavaScript origins: http://localhost:8000
# Authorized redirect URIs: http://localhost:8000/api/auth/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/auth/callback
YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/userinfo.profile

# Logging Settings
LOG_LEVEL=INFO
